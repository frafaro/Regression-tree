# install.packages("ISLR2")
library(ISLR2)
data("Carseats")
attach(Carseats)
View(Carseats)
ntr <- round(nrow(Carseats)*0.70)  # numero unita nel training sample
set.seed(123456)
indice <- sample(1:nrow(Carseats),ntr)
train <- Carseats[indice,]  # training sample
test <- Carseats[-indice,]  # test sample
library(rpart)
library(rpart.plot)
tree<-rpart(formula = Sales~. ,
data= train,
method = "anova")
pred_val<-predict(tree, newdata = test)
mean((pred_val-test$Sales)^2) #MSE 4.912664
plotcp(tree) # il grafico ci dice di potare ball'altezza del nodo numero 8 #cp 0.025
tree_pruned<-prune(tree, cp= 0.025)
pred_val.pruned<-predict(tree_pruned, newdata = test)
mean((pred_val.pruned-test$Sales)^2) #MSE 4.982664  questo modello è meno preciso del primo infatti l'MSE è più elevata
library(randomForest)
set.seed(1)
bagging<-randomForest( formula= Sales~ . ,
data= train,
mtry= ncol(train)-1,
importance= T)
varImpPlot(bagging) #covariata più imp. sheiveloc, price
pred_val.bagging<-predict(bagging, newdata = test)
mean((pred_val.bagging-test$Sales)^2) #2.476998 riotto rispetto ai modelli precedenti
set.seed(1)
RF<-randomForest(formula= Sales~ . ,
data= train,
mtry= sqrt(ncol(train)-1) ,
importance= T)
varImpPlot(RF)
pred_val_RF<-predict(RF, newdata = test)
mean((pred_val_RF-test$Sales)^2) #2.649523 più elevato del modello bagging
plot(RF)
rpart.plot(RF)
rpart.plot(tree_pruned)
View(bagging)
varImpPlot(bagging) #covariata più imp. sheiveloc, price
library(ISLR2)
library(rpart)
library(rpart.plot)
library(randomForest)
data("Carseats")
View(Carseats)
# Inspect the dataset
dim(Carseats)
str(Carseats)
summary(Carseats)
# Basic exploratory plots
par(mfrow = c(1, 2))
hist(Carseats$Sales,
main = "Distribution of Store Sales",
xlab = "Sales",
col = "lightblue",
border = "white")
boxplot(Sales ~ ShelveLoc,
data = Carseats,
main = "Sales by Shelf Location",
xlab = "Shelf Location",
ylab = "Sales",
col = "lightgreen")
# Set the random seed to reproduce the same split.
set.seed(123456)
n <- nrow(Carseats)
# Select 70% of the observations for training.
n_train <- round(0.70 * n)
# Randomly sample training observation indices.
train_indices <- sample(seq_len(n), size = n_train)
train <- Carseats[train_indices, ]
test  <- Carseats[-train_indices, ]
View(train)
mse <- function(actual, predicted) {
mean((actual - predicted)^2)
}
rmse <- function(actual, predicted) {
sqrt(mse(actual, predicted))
}
tree <- rpart(
Sales ~ .,
data = train,
method = "anova",
## this are the default control setting
## it is possible to stop at "method"
control = rpart.control(
cp = 0.001,
minsplit = 20,
minbucket = 7,
maxdepth = 30,
xval = 10
)
)
# Display the fitted tree structure
print(tree)
rpart.plot(
tree,
type = 2,
extra = 101,
fallen.leaves = TRUE,
main = "Regression Tree for Carseats Sales"
)
library(ISLR2)
library(rpart)
library(rpart.plot)
library(randomForest)
data("Carseats")
# Set the random seed to reproduce the same split.
set.seed(123456)
n <- nrow(Carseats)
# Select 70% of the observations for training.
n_train <- round(0.70 * n)
# Randomly sample training observation indices.
train_indices <- sample(seq_len(n), size = n_train)
train <- Carseats[train_indices, ]
test  <- Carseats[-train_indices, ]
# Check sample sizes
nrow(train)
nrow(test)
mse <- function(actual, predicted) {
mean((actual - predicted)^2)
}
rmse <- function(actual, predicted) {
sqrt(mse(actual, predicted))
}
tree <- rpart(
Sales ~ .,
data = train,
method = "anova",
## this are the default control setting
## it is possible to stop at "method"
control = rpart.control(
cp = 0.001,
minsplit = 20,
minbucket = 7,
maxdepth = 30,
xval = 10
)
)
# Display the fitted tree structure
print(tree)
rpart.plot(
tree,
type = 2,
extra = 101,
fallen.leaves = TRUE,
main = "Regression Tree for Carseats Sales"
)
rpart.plot(
tree,
type = 2,
extra = 101,
fallen.leaves = TRUE,
main = "Regression Tree for Carseats Sales"
)
# Predict Sales for observations in the test set.
pred_tree <- predict(tree, newdata = test)
# Evaluate out-of-sample predictive performance.
mse_tree <- mse(test$Sales, pred_tree)
rmse_tree <- sqrt(mse_tree)
mse_tree
rmse_tree
# plot the visual representation of the cross validation results
plotcp(tree)
tree_pruned<-prune(tree, cp= 0.025)
# Plot the pruned tree.
rpart.plot(
tree_pruned,
type = 2,
extra = 101,
fallen.leaves = TRUE,
main = "Pruned Regression Tree"
)
print(tree_pruned)
# Compare the original and pruned trees.
cat("Original terminal nodes:",
sum(tree$frame$var == "<leaf>"), "\n")
cat("Pruned terminal nodes:",
sum(tree_pruned$frame$var == "<leaf>"), "\n")
# Evaluate the pruned model on the SAME test set.
pred_pruned <- predict(tree_pruned, newdata = test)
mse_pruned <- mse(test$Sales, pred_pruned)
rmse_pruned <- sqrt(mse_pruned)
mse_pruned
rmse_pruned
set.seed(1)
p <- ncol(train) - 1 #minus one since the prediction variable is as well a column of the train set
bagging <- randomForest(
formual = Sales ~ .,
data = train,
ntree = 500,
mtry = p,
importance = TRUE
)
bagging <- randomForest(
formula = Sales ~ .,
data = train,
ntree = 500,
mtry = p,
importance = TRUE
)
plot(
bagging,
main = "Bagging: Out-of-Bag Error vs Number of Trees"
)
# Predict on the held-out test set.
pred_bagging <- predict(bagging, newdata = test)
mse_bagging <- mse(test$Sales, pred_bagging)
rmse_bagging <- sqrt(mse_bagging)
mse_bagging
rmse_bagging #
# Estimate predictor importance.
importance(bagging)
varImpPlot(
bagging,
main = "Bagging: Predictor Importance"
)
set.seed(1)
mtry_rf <- max(1, floor(sqrt(p)))
RF <- randomForest(
Sales ~ .,
data = train,
ntree = 500,
mtry = mtry_rf,
importance = TRUE
)
# Inspect the internal OOB error.
plot(
RF,
main = "Random Forest: Out-of-Bag Error vs Number of Trees"
)
# Predict on the held-out test set.
pred_RF <- predict(RF, newdata = test)
mse_RF <- mse(test$Sales, pred_RF)
rmse_RF <- sqrt(mse_RF)
mse_RF
rmse_RF
varImpPlot(
RF,
main = "Random Forest: Predictor Importance"
)
cat("Number of predictors:", p, "\n")
cat("Bagging mtry:", p, "\n")
cat("Random forest mtry:", mtry_rf, "\n")
results <- data.frame(
Model = c(
"Regression tree",
"Pruned tree (minimum CV error)",
"Bagging",
"Random forest"
),
Test_MSE = c(
mse_tree,
mse_pruned,
mse_bagging,
mse_RF
)
)
results$Test_RMSE <- sqrt(results$Test_MSE)
View(results)
# Order models from lowest to highest test MSE.
results <- results[order(results$Test_MSE), ]
print(results, row.names = FALSE)
# Bar chart comparing test MSE.
barplot(
results$Test_MSE,
names.arg = results$Model,
las = 2,
col = "lightblue",
main = "Out-of-Sample Predictive Performance",
ylab = "Test MSE",
cex.names = 0.8
)
results <- data.frame(
Model = c(
"Regression tree",
"Pruned tree",
"Bagging",
"Random forest"
),
Test_MSE = c(
mse_tree,
mse_pruned,
mse_bagging,
mse_RF
)
)
results$Test_RMSE <- sqrt(results$Test_MSE)
# Order models from lowest to highest test MSE.
results <- results[order(results$Test_MSE), ]
print(results, row.names = FALSE)
# Bar chart comparing test MSE.
barplot(
results$Test_MSE,
names.arg = results$Model,
las = 2,
col = "lightblue",
main = "Out-of-Sample Predictive Performance",
ylab = "Test MSE",
cex.names = 0.8
)
predictions <- list(
"Regression tree" = pred_tree,
"Pruned tree" = pred_pruned,
"Bagging" = pred_bagging,
"Random forest" = pred_RF
)
par(mfrow = c(2, 2))
for (model_name in names(predictions)) {
plot(
test$Sales,
predictions[[model_name]],
xlab = "Observed Sales",
ylab = "Predicted Sales",
main = model_name,
pch = 19,
col = "steelblue"
)
abline(0, 1, lty = 2, col = "red", lwd = 2)
}
par(mfrow = c(1, 1))
best_model_name <- results$Model[1]
best_predictions <- switch(
best_model_name,
"Regression tree" = pred_tree,
"Pruned tree" = pred_pruned,
"Bagging" = pred_bagging,
"Random forest" = pred_RF
)
residuals_best <- test$Sales - best_predictions
plot(
best_predictions,
residuals_best,
xlab = "Predicted Sales",
ylab = "Residuals",
main = paste("Residual Diagnostics:", best_model_name),
pch = 19,
col = "steelblue"
)
abline(h = 0, lty = 2, col = "red", lwd = 2)
# Calculate out-of-sample R-squared
r2_test <- function(actual, predicted) {
1 - sum((actual - predicted)^2) /
sum((actual - mean(actual))^2)
}
# Calculate test R-squared for each model
r2_tree <- r2_test(test$Sales, pred_tree)
r2_pruned <- r2_test(test$Sales, pred_pruned)
r2_bagging <- r2_test(test$Sales, pred_bagging)
r2_RF <- r2_test(test$Sales, pred_RF)
results <- data.frame(
Model = c(
"Regression tree",
"Pruned tree",
"Bagging",
"Random forest"
),
Test_MSE = c(
mse_tree,
mse_pruned,
mse_bagging,
mse_RF
),
R2_test = c(
r2_tree,
r2_pruned,
r2_bagging,
r2_RF
)
)
results$Test_RMSE <- sqrt(results$Test_MSE)
# Order models from lowest to highest test MSE.
results <- results[order(results$Test_MSE), ]
print(results, row.names = FALSE)
# Bar chart comparing test MSE.
barplot(
results$Test_MSE,
names.arg = results$Model,
las = 2,
col = "lightblue",
main = "Out-of-Sample Predictive Performance",
ylab = "Test MSE",
cex.names = 0.8
)
