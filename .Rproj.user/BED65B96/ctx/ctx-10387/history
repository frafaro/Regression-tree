#install.packages("nycflights13")
library(nycflights13)
data("planes")
planes
planes %>%
count(tailnum)
planes %>%
group_by(tailnum) %>%
summarise(n=n()) %>%
filter(n>1)
flights %>%
left_join(planes, by= "tailnum")
flights_with_plane<-flights %>%
left_join(planes, by= "tailnum")
View(flights_with_plane)
flights_with_plane<-flights %>%
left_join(planes, by= ("tailnum"="tailnum"))
