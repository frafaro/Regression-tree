library(dbplyr)
library(RSQLite)
library(DBI)
library(nycflights13)
data("flights")
connected_DB<- dbConnect(SQLite(), ":memory:") #crea sessione SQL su R
flights_DB<- copy_to(connected_DB, nycflights13::flights)
flights_DB %>%
select(contains("delay"))
flights_DB %>%
select(contains("delay")) %>%
show_query() #come source dice sql
flights_DB %>%
select(distance, air_time) %>%
mutate(speed= distance/(air_time/60)) %>%
show_query()
flights_DB %>%
group_by(month, day) %>%
summarise(delay=mean(arr_delay, na.rm = T)) %>%
show_query()
