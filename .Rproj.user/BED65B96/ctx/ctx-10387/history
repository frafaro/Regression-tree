library(tidyverse)
flights %>%
group_by(year, month, day) %>%
summarise(rit_max= max(arr_delay, na.rm = T), #ritardo max senza contare NA
n_NA= sum(is.na(arr_delay)),
n= n())
flights %>%
group_by(year, month, day) %>%
summarise(rit_max= max(arr_delay, na.rm = T), #ritardo max senza contare NA
n_NA= sum(is.na(arr_delay)),        #numero di NA usiamo la funz sum
n= n()) %>%
mutate(freq_NA= n_NA/n*100) %>%
filter(freq_NA > 10)
