library(nycflights13)

# Carichiamo i dati
data("flights")
flights # equivalente a print(flights)
class(flights)

# trasformiamolo in data.frame
flight_dataframe <- as.data.frame(flights)
class(flight_dataframe)
flight_dataframe
str(flights)
