#####Filtro dataset ###########

# selezionare solo i voli partiti il primo gennaio

flights_1_1 <- flights %>% 
  filter(month == 1, day == 1)

# selezionare i voli partiti il 1 e 5 gennaio


flights %>% 
  filter(month == 1, day == 1 | day == 5)

flights %>% 
  filter(month == 1, day %in% c(1,5))

# voli con un ritardo all'arrivo maggiore di 120 minuti

flights %>% 
  filter(arr_delay > 120)

#########Salviamo il dataset nuovo###########

write_csv2(flights_1_1, file = "data/voli1gennaio.csv") #lo salviamo nella cartella dati


######## Ordinamento dataset##########

# ordinare il dataset rispetto al ritardo all'arrivo (decrescente)
flights %>% 
  arrange(desc(arr_delay))
  
# ordinare in maniera decrescente sia rispetto al mese che al ritardo
flights %>% 
  arrange(desc(month), desc(arr_delay))

######## Selezione variabili ####################

# selezioniamo time_hour, dest, distance

flights %>% 
  select(time_hour, dest, distance)

# se volessimo solo cambiare l'ordine

flights %>% 
  select(time_hour, dest, distance, everything())

#########Creazione nuove variabili#######################################

# creazione "guadagno" come differenza tra dep_delay e arr_delay

flights %>% 
  mutate(guadagno = dep_delay - arr_delay)

# creazione variabile nuova eliminando le vecchie

flights %>% 
  transmute(guadagno = dep_delay - arr_delay)


####Sintesi variabili###################

# calcolare la distanza media dei voli e ritardo massimo

flights %>% 
  summarise(dist_media = mean(distance),     #si da un nome alla variabile e poi si da la funzione
            rit_max = max(arr_delay))

flights %>% 
  summarise(dist_media = mean(distance, na.rm = T), 
            rit_max = max(arr_delay, na.rm = T))

# stesse sintesi per ogni mese

flights %>% 
  group_by(month) %>% 
  summarise(dist_media = mean(distance, na.rm = T), 
            rit_max = max(arr_delay, na.rm = T))

####combinare più istruzioni############################

# selezionare il mese di gennaio e calcolare la distanza media e il ritardo massimo rispetto ai giorni

flights %>% 
  filter(month == 1) %>% 
  group_by(day) %>% 
  summarise(dist_media = mean(distance, na.rm = T), 
            rit_max = max(arr_delay, na.rm = T))


#### conteggio frequenze ####

flights %>% 
  group_by(year, month, day) %>% 
  summarise(rit_max= max(arr_delay, na.rm = T), #ritardo max senza contare NA
            n_NA= sum(is.na(arr_delay)),        #numero di NA usiamo la funz sum
            n= n()) %>%                         #numero osservazione tot
  mutate(freq_NA= n_NA/n*100) %>%               #creo nuova variabile con proporzione di NA
  filter(freq_NA > 10)                          #tengo le oss maggiori del 10%

