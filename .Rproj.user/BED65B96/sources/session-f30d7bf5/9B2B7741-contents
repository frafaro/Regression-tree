#### apllicazione in SQL ####

# install.packages("RSQLite")

library(dbplyr)  
library(RSQLite)
library(DBI)
library(nycflights13)
data("flights")

connected_DB<- dbConnect(SQLite(), ":memory:") #crea sessione SQL su R
flights_DB<- copy_to(connected_DB, nycflights13::flights) #associare alla sessione SQL i dati che vogliamo

# es1 selezionare colonne relative al ritardo

flights_DB %>% 
  select(contains("delay")) %>% 
  show_query() #come source dice sql e ci mostra anche il codice che avremmo usato su SQL

#es2 selezioniamo distanza e tempo di volo e calcoliamo velocità media

flights_DB %>% 
  select(distance, air_time) %>% 
  mutate(speed= distance/(air_time/60)) %>% 
  show_query()

#es3 ritardo medio giornaliero

flights_DB %>% 
  group_by(month, day) %>% 
  summarise(delay=mean(arr_delay, na.rm = T)) %>% 
  show_query()




