library(tidyverse)
data_stud<-read_csv("data_stud.csv")
View(data_stud)
library(ggplot2)
data_stud %>%
ggplot(aes(x=Minority))+
geom_bar()
data_stud %>%
count(Minority)
data_stud %>%
count(Sex)
data_stud %>%
ggplot(aes(x = Ses, y = MathAch))+
geom_point()+
geom_smooth()+
labs(x = "Status Socio-Economico",
y="Punteggio Matematica")
data_stud %>%
ggplot(aes(x = SES, y = MathAch))+
geom_point()+
geom_smooth()+
labs(x = "Status Socio-Economico",
y="Punteggio Matematica")
data_stud %>%
ggplot(aes(x = SES, y = MathAch))+
geom_point()+
geom_smooth()+
labs(x = "Status Socio-Economico",
y="Punteggio Matematica")+
facet_grid(.~Sex)
data_stud %>%
ggplot(aes(x = MathAch, color = Sex))+
geom_density()
data_stud %>%
ggplot(aes(y = MathAch, x = Sex, fill = Sex))+
geom_boxplot()
data_stud2<-data_stud %>%
select(-"Minority") %>%
group_by("School") %>%
summarise(Mean_SES= mean(SES), Mean_MathAch= mean(MathAch))
View(data_stud2)
data_stud2<-data_stud %>%
select(-"Minority") %>%
group_by(School) %>%
summarise(Mean_SES= mean(SES), Mean_MathAch= mean(MathAch))
data_school<-read_csv("data_school.csv")
View(data_school)
data_school_stud <- data_school %>%
left_join(data_stud2, by = ("School"="School"))
View(data_school_stud)
View(data_school)
sum(table(data_school$School)!=1)
source("~/Desktop/esame/cognome_nome.R")
set.seed(178)
training <- data_school_stud %>%
sample_frac(.8)
View(training)
test <- anti_join(data_school_stud, training)
View(test)
library(rpart)
library(rpart.plot)
set.seed(178)
training <- data_school_stud %>%
sample_frac(.8)
library(tidyverse)
set.seed(178)
training <- data_school_stud %>%
sample_frac(.8)
test <- anti_join(data_school_stud, training, by= "School")
tree <- rpart(formula = Mean_MathAch~Size+Sector+PRACAD+DISCLIM+Mean_SES,
data=training,
method = "anova")
rpart.plot(tree)
plotcp(tree)
printcp(tree)
tree_pruned <- prune(tree, cp = 0.034)
rpart.plot(tree_pruned)
library(tidyverse)
data_stud<-read_csv("data_stud.csv")
data_stud %>%
count(Minority)
data_stud %>%
count(Sex)
data_stud %>%
ggplot(aes(x = SES, y = MathAch))+
geom_point()+
geom_smooth()+
labs(x = "Status Socio-Economico",
y="Punteggio Matematica")
data_stud %>%
ggplot(aes(x = SES, y = MathAch))+
geom_point()+
geom_smooth()+
labs(x = "Status Socio-Economico",
y="Punteggio Matematica")+
facet_grid(.~Sex)
data_stud %>%
ggplot(aes(y = MathAch, x = Sex, fill = Sex))+
geom_boxplot()
View(data_stud)
data_stud2<-data_stud %>%
select(-"Minority") %>%
group_by(School) %>%
summarise(Mean_SES= mean(SES), Mean_MathAch= mean(MathAch))
View(data_stud2)
data_stud2<-data_stud %>%
select(-"Minority", -"Sex") %>%
group_by(School) %>%
summarise(Mean_SES= mean(SES), Mean_MathAch= mean(MathAch))
data_school<-read_csv("data_school.csv")
View(data_school)
sum(table(data_school$School)!=1) #non ci son o valori che si ripetono quindi la posso usare come chiave primaria
data_school_stud <- data_school %>%
left_join(data_stud2, by = ("School"="School"))
View(data_school_stud)
set.seed(178)
training <- data_school_stud %>%
sample_frac(.8)
test <- anti_join(data_school_stud, training)
library(rpart)
library(rpart.plot)
tree <- rpart(formula = Mean_MathAch~Size+Sector+PRACAD+DISCLIM+Mean_SES,
data=training,
method = "anova")
rpart.plot(tree)
plotcp(tree) #come valore di alpha devo usare 0.034
printcp(tree)
tree_pruned <- prune(tree, cp = 0.034)
rpart.plot(tree_pruned)
pred_val <- predict(tree_pruned, newdata = test)
pred_val
pred_val<-predict(tree_pruned, newdata = test)
MSE<- sum(test-pred_val)^2
MSE<- sum(test$Mean_MathAch-pred_val)^2
MSE<- mean(test$Mean_MathAch-pred_val)^2
MSE<- mean((pred_val-test$Mean_MathAch)ˆ2)
MSE<- mean((pred_val-test$Mean_MathAch)^2)
rf1<-randomForest(formula = training$Mean_MathAch~.,
data=training, mtry = ncol(training)-1,
importance = T)
library(randomForest)
